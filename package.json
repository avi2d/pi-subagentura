{
  "name": "pi-subagentura",
  "version": "2.4.1",
  "description": "Public Pi package that adds in-process sub-agents via the SDK",
  "author": "lmn451",
  "license": "MIT",
  "main": "src/subagent.ts",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "agent",
    "multi-agent",
    "swarm",
    "crew"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/pi-subagentura"
  },
  "homepage": "https://github.com/lmn451/pi-subagentura#readme",
  "bugs": {
    "url": "https://github.com/lmn451/pi-subagentura/issues"
  },
  "files": [
    "LICENSE",
    "skills/orchestrator/SKILL.md",
    "src/ndjson.d.ts",
    "src/notifications.ts",
    "src/rendering.ts",
    "src/schemas.ts",
    "src/artifact.ts",
    "src/artifact-poller.ts",
    "src/child-protocol.ts",
    "src/delivery.ts",
    "src/helpers.ts",
    "src/tools/in-process.ts",
    "src/tools/interactive.ts",
    "src/interactive-tmux.ts",
    "src/multiplexer.ts",
    "src/multiplexer-tmux.ts",
    "src/multiplexer-zellij.ts",
    "src/rehydrate.ts",
    "src/session-handlers.ts",
    "src/subagent.ts",
    "src/subagent-artifact-cli.ts",
    "src/workflow.ts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/subagent.ts"
    ],
    "skills": [
      "./skills/orchestrator"
    ]
  },
  "scripts": {
    "test": "vitest run --exclude tests/tmux.integration.test.ts",
    "test:unit": "vitest run --exclude tests/tmux.integration.test.ts --exclude tests/pi-session-delivery.integration.test.ts",
    "test:pi": "vitest run tests/pi-session-delivery.integration.test.ts",
    "test:tmux": "vitest run tests/tmux.integration.test.ts",
    "coverage:check": "vitest run --coverage --exclude tests/tmux.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "simple-git-hooks",
    "pack:check": "npm pack --dry-run"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run format:check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.6 <0.81.0",
    "@earendil-works/pi-ai": ">=0.80.6 <0.81.0",
    "@earendil-works/pi-coding-agent": ">=0.80.6 <0.81.0",
    "@earendil-works/pi-tui": ">=0.80.6 <0.81.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "is-path-inside": "^4.0.0",
    "ndjson": "^2.0.0"
  }
}
